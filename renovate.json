{
  "extends": ["config:recommended"],
  "timezone": "Europe/Paris",
  "schedule": ["after 10pm every weekday"],
  "prConcurrentLimit": 5,
  "prHourlyLimit": 2,
  "rebaseWhen": "behind-base-branch",
  "labels": ["renovate"],
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": ["security"]
  },
  "packageRules": [
    {
      "matchDatasources": ["docker"],
      "matchPackageNames": ["php"],
      "allowedVersions": "/^8\\.[2-9]\\./",
      "pinDigests": true,
      "automerge": true
    },
    {
      "matchDatasources": ["github-actions"],
      "pinDigests": false,
      "automerge": false
    }
  ]
}